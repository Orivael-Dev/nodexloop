    "id": "phone-normalizer",
    "prompt": "Implement normalize_phone(value). Extract digits. If exactly 10 digits remain, return that digit string. If exactly 11 digits remain and the first is 1, remove the leading 1. Otherwise return None.",
    "entrypoint": "normalize_phone",
    "starter": "def normalize_phone(value):\n    return ''.join(ch for ch in value if ch.isdigit())\n",
