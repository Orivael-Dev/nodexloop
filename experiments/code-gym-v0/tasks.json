  {
    "id": "word-count",
    "prompt": "Implement count_words(text). Count case-insensitive contiguous ASCII letters and digits ([a-z0-9]+) as words. Punctuation, hyphens and whitespace separate words. Return a dict of word -> integer count.",
    "entrypoint": "count_words",
    "starter": "def count_words(text):\n    return {word: text.split().count(word) for word in text.split()}\n",
