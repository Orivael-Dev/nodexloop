  {
    "id": "discount-cents",
    "prompt": "Implement discounted_cents(items, percent). Items are dicts with nonnegative integer qty and unit_cents. percent must be an integer from 0 to 100. Return None for invalid inputs. Otherwise return floor(sum(qty*unit_cents)*(100-percent)/100) as integer cents, never using floating point.",
    "entrypoint": "discounted_cents",
    "starter": "def discounted_cents(items, percent):\n    return sum(i[\"qty\"] * i[\"unit_cents\"] for i in items) * (100-percent) / 100\n",
