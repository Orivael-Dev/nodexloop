  {
    "id": "backoff",
    "prompt": "Implement capped_backoff(attempt, base, cap). For integer attempt >= 1, positive integer base, and cap >= base return min(cap, base * 2**(attempt-1)). Otherwise return None. Handle very large attempts efficiently without computing enormous powers.",
    "entrypoint": "capped_backoff",
    "starter": "def capped_backoff(attempt, base, cap):\n    return min(cap, base * (2 ** attempt))\n",
