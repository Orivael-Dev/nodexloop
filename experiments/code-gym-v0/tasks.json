[
  {
    "id": "appointments",
    "prompt": "Implement is_available(bookings, start, end). Return False for invalid intervals (start >= end). Ignore bookings whose status is 'cancelled'; missing status means active. Treat intervals as [start,end), so touching boundaries do NOT overlap. Return True only if there is no active overlap.",
    "entrypoint": "is_available",
    "starter": "def is_available(bookings, start, end):\n    for booking in bookings:\n        if start <= booking[\"end\"] and end >= booking[\"start\"]:\n            return False\n    return True\n",
    "visible": [
      {
        "args": [
          [
            {
              "start": 10,
              "end": 12
            }
          ],
          12,
          13
        ],
        "expected": true
      },
      {
        "args": [
          [
            {
              "start": 10,
              "end": 12
            }
          ],
          11,
          13
        ],
        "expected": false
      },
      {
        "args": [
          [],
          6,
          6
        ],
        "expected": false
      }
    ],
    "hidden": [
      {
        "args": [
          [
            {
              "start": 10,
              "end": 12,
              "status": "cancelled"
            }
          ],
          11,
          13
        ],
        "expected": true
      },
      {
        "args": [
          [
            {
              "start": 10,
              "end": 12
            }
          ],
          9,
          10
        ],
        "expected": true
      },
      {
        "args": [
          [
            {
              "start": 10,
              "end": 12,
              "status": "active"
            }
          ],
          10,
          11
        ],
        "expected": false
      },
      {
        "args": [
          [],
          3,
          5
        ],
        "expected": true
      }
    ]
  },
