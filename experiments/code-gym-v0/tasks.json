    "id": "chunking",
    "prompt": "Implement chunk_items(items, size). Return consecutive chunks of length <= size, preserving order. For size <= 0 return an empty list. Inputs are ordinary JSON-compatible lists.",
    "entrypoint": "chunk_items",
    "starter": "def chunk_items(items, size):\n    return [items[i:i+size] for i in range(0, len(items), size)]\n",
