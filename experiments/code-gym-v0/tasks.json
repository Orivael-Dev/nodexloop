  {
    "id": "slugify",
    "prompt": "Implement slugify(title). Keep lowercase ASCII a-z and digits 0-9; convert any contiguous run of other characters to one '-'; strip leading/trailing hyphens. Empty input returns empty string. Do not use third-party packages.",
    "entrypoint": "slugify",
    "starter": "def slugify(title):\n    return title.lower().replace(\" \", \"-\")\n",
